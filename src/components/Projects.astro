---
import projectsData from '../content/projects.json';
---

<section class="scene projects" id="projects" aria-label="Projects">
  <div class="projects__inner grid">
    <div class="projects__header col-content">
      <span class="label">11:00 PM</span>
      <h2>Projects.</h2>
    </div>
    <div class="projects__list col-content">
      {projectsData.map(project => (
        <article class="projects__card">
          <h3><a href={`/projects/${project.slug}`}>{project.title}</a></h3>
          <p>{project.summary}</p>
          <div class="projects__stack">
            {project.stack.slice(0, 5).map(tech => (
              <span class="projects__tech mono">{tech}</span>
            ))}
            {project.stack.length > 5 && (
              <span class="projects__tech mono">+{project.stack.length - 5}</span>
            )}
          </div>
          <div class="projects__contributors">
            {project.contributors.map(c => (
              <span class="projects__contributor">{c}</span>
            ))}
          </div>
          <div class="projects__links">
            {project.links.demo && <a href={project.links.demo} class="btn btn-ghost">Demo</a>}
            {project.links.github && <a href={project.links.github} class="btn btn-ghost">GitHub</a>}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .projects__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .projects__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  .projects__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    padding: var(--space-lg);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 4px;
  }

  .projects__card h3 a {
    color: var(--text-primary);
    font-size: var(--text-xl);
  }

  .projects__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-sm);
  }

  .projects__tech {
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 2px;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .projects__contributors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .projects__contributor:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-sm);
    color: var(--text-muted);
  }

  .projects__links {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
</style>
