---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`cable-container ${className}`} id="hero-cable-container" aria-hidden="true">
  <svg class="cable-svg" width="100%" height="100%">
    <defs>
      <filter id="cable-glow" x="-50%" y="-50%" width="200%" height="200%">
        <feGaussianBlur stdDeviation="3" result="blur" />
        <feMerge>
          <feMergeNode in="blur" />
          <feMergeNode in="SourceGraphic" />
        </feMerge>
      </filter>
    </defs>

    <!-- 4 Parallel Strands (Red, Green, Blue, Yellow) -->
    <path class="cable-strand strand-red" stroke="var(--ms-red)" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <path class="cable-strand strand-green" stroke="var(--ms-green)" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <path class="cable-strand strand-blue" stroke="var(--ms-blue)" stroke-width="2.5" fill="none" stroke-linecap="round" />
    <path class="cable-strand strand-yellow" stroke="var(--ms-yellow)" stroke-width="2.5" fill="none" stroke-linecap="round" />

    <!-- Pulse effect ring upon plugging into tower -->
    <circle class="cable-pulse" cx="0" cy="0" r="0" fill="none" stroke="var(--ms-blue)" stroke-width="3" />
  </svg>
</div>

<style>
  .cable-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: var(--z-cable);
    overflow: visible;
  }

  .cable-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .cable-strand {
    filter: drop-shadow(0 0 6px currentColor);
    opacity: 0.95;
  }

  .strand-red { color: var(--ms-red); }
  .strand-green { color: var(--ms-green); }
  .strand-blue { color: var(--ms-blue); }
  .strand-yellow { color: var(--ms-yellow); }

  .cable-pulse {
    opacity: 0;
    pointer-events: none;
  }

  .pulse-active {
    animation: cablePulseAnim 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes cablePulseAnim {
    0% {
      r: 6px;
      opacity: 1;
      stroke: var(--ms-blue);
      stroke-width: 4px;
    }
    50% {
      stroke: var(--ms-yellow);
    }
    100% {
      r: 90px;
      opacity: 0;
      stroke-width: 1px;
    }
  }
</style>

<script>
  import { HeroCable } from '../scripts/cable';

  const container = document.getElementById('hero-cable-container');
  if (container) {
    new HeroCable(container);
  }
</script>
