---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Projects from '../components/Projects.astro';
import Events from '../components/Events.astro';
import Podcast from '../components/Podcast.astro';
import Blog from '../components/Blog.astro';
import Join from '../components/Join.astro';
import Footer from '../components/Footer.astro';
import ClockTower from '../components/ClockTower.astro';
import Vine from '../components/Vine.astro';

// Gather JSON-LD for events, episodes
import eventsData from '../content/events.json';
import episodesData from '../content/episodes.json';
import postsData from '../content/posts.json';

const eventJsonLd = eventsData
  .filter(e => e.date)
  .map(e => ({
    "@context": "https://schema.org",
    "@type": "Event",
    "name": e.title,
    "startDate": e.date,
    "description": e.summary,
    "organizer": {
      "@type": "Organization",
      "name": "Microsoft Club GIKI",
      "url": "https://mlsaclubgiki.tech"
    },
    "location": {
      "@type": "Place",
      "name": "Ghulam Ishaq Khan Institute",
      "address": "Topi, Swabi, Khyber Pakhtunkhwa, Pakistan"
    },
    "url": `https://mlsaclubgiki.tech/events/${e.slug}`
  }));

const episodeJsonLd = episodesData
  .filter(e => e.date)
  .map(e => ({
    "@context": "https://schema.org",
    "@type": "PodcastEpisode",
    "name": e.title,
    "datePublished": e.date,
    "description": e.summary,
    "episodeNumber": e.ep,
    "partOfSeries": {
      "@type": "PodcastSeries",
      "name": "Logikal",
      "url": "https://www.youtube.com/@LOGIKALGIKI"
    },
    "url": `https://mlsaclubgiki.tech/podcast/${e.slug}`
  }));

const postJsonLd = postsData
  .filter(p => p.date)
  .map(p => ({
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": p.title,
    "author": {
      "@type": "Person",
      "name": p.author
    },
    "datePublished": p.date,
    "url": `https://mlsaclubgiki.tech/blog/${p.slug}`
  }));

const allJsonLd = [...eventJsonLd, ...episodeJsonLd, ...postJsonLd];
---

<BaseLayout jsonLd={allJsonLd}>
  <Nav />

  <!-- Continuous Pixel-Style Stepped Vine in Left Gutter -->
  <Vine />

  <!-- Fixed Clock Tower Background Layer on the Right Side of the Viewport -->
  <aside class="fixed-tower-stage" aria-label="GIKI Clock Tower">
    <ClockTower class="fixed-tower" />
  </aside>

  <main>
    <Hero />
    <About />
    <Projects />
    <Events />
    <Podcast />
    <Blog />
    <Join />
  </main>

  <Footer />
</BaseLayout>

<style>
  main {
    position: relative;
    z-index: 1;
  }

  .fixed-tower-stage {
    position: fixed;
    right: clamp(16px, 4vw, 70px);
    bottom: 0;
    z-index: 25; /* below content which has z-index 100 */
    pointer-events: auto;
    display: flex;
    justify-content: flex-end;
    align-items: flex-end;
    height: 100vh;
    max-width: 360px;
    width: 32vw;
    transition: opacity var(--duration-normal) var(--ease-out);
  }

  .fixed-tower {
    max-height: 84vh;
    width: auto;
  }

  @media (max-width: 900px) {
    .fixed-tower-stage {
      right: 2%;
      max-width: 200px;
      width: 42vw;
      opacity: 0.35;
      z-index: 10;
    }

    .fixed-tower {
      max-height: 50vh;
    }
  }

  @media (max-width: 768px) {
    .fixed-tower-stage {
      display: none;
    }
  }
</style>

<script>
  import '../scripts/scroll-engine';
</script>
