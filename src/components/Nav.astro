---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navLinks = [
  { label: 'Join', href: `${base}/#join` },
  { label: 'Events', href: `${base}/#events` },
  { label: 'Projects', href: `${base}/#projects` },
  { label: 'Podcast', href: `${base}/#podcast` },
  { label: 'Blog', href: `${base}/#blog` },
];
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner">
    <a href={`${base}/#home`} class="nav__logo" aria-label="Microsoft Club GIKI — Home">
      <img
        src={`${base}/assets/club/logo-microsoft-club-giki.png`}
        alt="Microsoft Club GIKI Logo"
        height="36"
        class="nav__logo-img"
      />
    </a>

    <div class="nav__links" role="list">
      {navLinks.map(link => (
        <a href={link.href} class="nav__link" role="listitem">{link.label}</a>
      ))}
      <a href={`${base}/admin`} class="nav__admin-btn" aria-label="Admin login" title="Admin login">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
        </svg>
      </a>
    </div>

    <button type="button" class="nav__menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="3" y1="6" x2="21" y2="6" />
        <line x1="3" y1="12" x2="21" y2="12" />
        <line x1="3" y1="18" x2="21" y2="18" />
      </svg>
    </button>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="nav__mobile" aria-hidden="true">
    <div class="nav__mobile-inner">
      {navLinks.map(link => (
        <a href={link.href} class="nav__mobile-link">{link.label}</a>
      ))}
      <a href={`${base}/admin`} class="nav__mobile-link" style="color: var(--ms-blue); font-size: var(--text-lg); margin-top: 1rem;">
        🔒 Admin Login
      </a>
    </div>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: var(--z-nav);
    padding: var(--space-sm) var(--grid-margin);
    background: rgba(7, 11, 26, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    max-width: var(--grid-max-width);
    margin-inline: auto;
  }

  .nav__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .nav__logo-img {
    height: 36px;
    width: auto;
    display: block;
    object-fit: contain;
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-left: auto;
  }

  .nav__link {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color var(--duration-fast) var(--ease-out);
    position: relative;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .nav__link:hover,
  .nav__link[aria-current="true"] {
    color: var(--text-primary);
  }

  .nav__link[aria-current="true"]::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--ms-blue);
  }

  .nav__admin-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 6px;
    color: var(--text-secondary);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 4px;
    margin-left: var(--space-xs);
    transition: color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out),
                background-color var(--duration-fast) var(--ease-out);
  }

  .nav__admin-btn:hover {
    color: var(--text-primary);
    border-color: var(--ms-blue);
    background: rgba(0, 164, 239, 0.1);
  }

  .nav__menu-btn {
    display: none;
    color: var(--text-primary);
  }

  .nav__mobile {
    display: none;
  }

  @media (max-width: 768px) {
    .nav {
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .nav__links {
      display: none;
    }

    .nav__menu-btn {
      display: block;
      margin-left: auto;
    }

    .nav__mobile[aria-hidden="false"] {
      display: flex;
      position: fixed;
      inset: 0;
      width: 100vw;
      min-height: 100dvh;
      background: var(--night-0);
      z-index: 1;
      align-items: center;
      justify-content: center;
      pointer-events: auto;
    }

    .nav__inner {
      position: relative;
      z-index: 2;
    }

    .nav__mobile-inner {
      display: flex;
      flex-direction: column;
      gap: var(--space-xl);
      text-align: center;
    }

    .nav__mobile-link {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      font-weight: 600;
      color: var(--text-primary);
    }
  }
</style>

<script>
  const setMenuOpen = (open: boolean) => {
    const menuButton = document.querySelector<HTMLButtonElement>('.nav__menu-btn');
    const mobileMenu = document.getElementById('mobile-menu');
    if (!menuButton || !mobileMenu) return;

    menuButton.setAttribute('aria-expanded', String(open));
    menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    mobileMenu.setAttribute('aria-hidden', String(!open));
    document.body.classList.toggle('menu-open', open);
  };

  if (!document.documentElement.dataset.navMenuBound) {
    document.documentElement.dataset.navMenuBound = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      if (target.closest('.nav__menu-btn')) {
        const button = document.querySelector<HTMLButtonElement>('.nav__menu-btn');
        setMenuOpen(button?.getAttribute('aria-expanded') !== 'true');
      } else if (target.closest('#mobile-menu a')) {
        setMenuOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') setMenuOpen(false);
    });
  }
</script>
