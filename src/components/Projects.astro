---
import projectsData from '../content/projects.json';
import Rail from './Rail.astro';
import WinCard from './WinCard.astro';
---

<section class="scene projects" id="projects" aria-label="Projects">
  <div class="projects__header grid">
    <div class="col-content">
      <span class="label">11:00 PM</span>
      <h2>Projects.</h2>
      <p class="projects__subtitle">Shipped by Microsoft Club members for the campus.</p>
    </div>
  </div>

  <div class="projects__rail-wrapper">
    <Rail label="Projects Showcase">
      {projectsData.map(project => (
        <WinCard title={`${project.slug}.exe`}>
          <div class="project-content">
            <h3 class="project-title">
              <a href={`/projects/${project.slug}`}>{project.title}</a>
            </h3>
            <p class="project-desc">{project.summary}</p>
            
            <div class="project-section">
              <span class="label">Tech Stack</span>
              <div class="project-stack">
                {project.stack.slice(0, 6).map(tech => (
                  <span class="tech-tag mono">{tech}</span>
                ))}
                {project.stack.length > 6 && (
                  <span class="tech-tag mono">+{project.stack.length - 6}</span>
                )}
              </div>
            </div>

            <div class="project-section">
              <span class="label">Contributors</span>
              <div class="project-contributors">
                {project.contributors.map(c => (
                  <span class="contributor-name">{c}</span>
                ))}
              </div>
            </div>

            <div class="project-actions">
              {project.links.demo && (
                <a href={project.links.demo} class="btn btn-primary btn-sm" target="_blank" rel="noopener noreferrer">
                  Live Demo
                </a>
              )}
              {project.links.github && (
                <a href={project.links.github} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer">
                  GitHub
                </a>
              )}
              <a href={`/projects/${project.slug}`} class="btn btn-ghost btn-sm">
                Details &rarr;
              </a>
            </div>
          </div>
        </WinCard>
      ))}
    </Rail>
  </div>
</section>

<style>
  .projects {
    overflow: hidden;
  }

  .projects__header {
    margin-bottom: var(--space-xl);
  }

  .projects__subtitle {
    margin-top: var(--space-xs);
    color: var(--text-muted);
  }

  .projects__rail-wrapper {
    width: 100%;
  }

  .project-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    height: 100%;
    justify-content: space-between;
  }

  .project-title {
    font-size: var(--text-2xl);
    line-height: 1.1;
  }

  .project-title a {
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .project-title a:hover {
    color: var(--ms-blue);
  }

  .project-desc {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .project-section {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tech-tag {
    padding: 2px 8px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .project-contributors {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-sm);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .contributor-name:not(:last-child)::after {
    content: '·';
    margin-left: var(--space-sm);
    color: var(--text-muted);
  }

  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-sm {
    padding: 4px 12px;
    font-size: var(--text-xs);
  }
</style>
