---
import SEO from '../components/SEO.astro';
import Cursor from '../components/Cursor.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  type?: string;
  jsonLd?: object | object[];
  noindex?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type,
  jsonLd,
  noindex = false,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Default Organization JSON-LD (always present on all pages)
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Microsoft Club GIKI",
  "alternateName": [
    "Microsoft Club-GIKI",
    "MLSA GIKI",
    "Microsoft Learn Student Ambassadors GIKI"
  ],
  "url": "https://mlsaclubgiki.tech",
  "logo": "https://mlsaclubgiki.tech/assets/logo.png",
  "sameAs": [
    "https://www.instagram.com/microsoftclubgiki/",
    "https://www.linkedin.com/company/microsoft-club-giki/",
    "https://www.youtube.com/@LOGIKALGIKI",
    "https://linktr.ee/MS_clubgiki"
  ]
};

const allJsonLd = jsonLd ? [orgJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [orgJsonLd];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070B1A" />

  <!-- Preload fonts -->
  <link rel="preload" href={`${base}/fonts/PixelifySans-Variable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/InstrumentSans-Variable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/JetBrainsMono-Variable.woff2`} as="font" type="font/woff2" crossorigin />

  <!-- Favicon -->
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48">
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>

  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    type={type}
    jsonLd={allJsonLd}
    noindex={noindex}
  />
</head>
<body>
  <Cursor />
  <slot />

  <!-- Background interactive cursor field (dashes) -->
  <script>
    import { initCursorField } from '../scripts/cursor-field.js';
    initCursorField();
  </script>
</body>
</html>

