---
import SkylineSVG from './SkylineSVG.astro';
import Cable from './Cable.astro';
---

<section class="scene hero" id="home" aria-label="Hero">
  <!-- Layer 0: Constellation particle background -->
  <canvas id="hero-constellation-canvas" class="hero__constellation" aria-hidden="true"></canvas>

  <!-- Layer 1: Abstract skyline at base -->
  <SkylineSVG />

  <!-- Layer 2: Cable -->
  <Cable class="hero__cable" />

  <!-- Layer 3: Content — in left 60% so it doesn't overlap the fixed tower on the right -->
  <div class="hero__content">
    <div class="hero__text-block">
      <div class="hero__pill label">
        <span class="hero__pill-dot" aria-hidden="true"></span>
        <span>The Clock Tower Never Sleeps</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line">Microsoft</span>
        <span class="hero__title-line">Club <span class="hero__title-accent">GIKI</span></span>
      </h1>

      <p class="hero__sub">Learn. Build. Lead.</p>

      <div class="hero__ctas">
        <a href="#join" class="btn btn-primary">Join us</a>
        <a href="#podcast" class="btn btn-ghost">Hear Logikal</a>
      </div>
    </div>
  </div>

  <!-- Ground fog -->
  <div class="hero__fog" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--night-0);
    padding-block: 0;
  }

  .hero__constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero__cable {
    z-index: 8;
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--grid-max-width);
    margin-inline: auto;
    padding-inline: var(--grid-margin);
    pointer-events: none;
  }

  .hero__text-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 540px;
    pointer-events: auto;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(11, 18, 48, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    width: fit-content;
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__pill-dot {
    width: 6px;
    height: 6px;
    background: var(--ms-green);
    box-shadow: 0 0 6px var(--ms-green);
    animation: blink 2.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero__title {
    line-height: 1;
    color: var(--text-primary);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    color: var(--ms-blue);
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero__fog {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to top, var(--night-0) 0%, transparent 100%);
    z-index: 55;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero__text-block {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .hero__ctas {
      flex-direction: column;
      width: 100%;
      max-width: 240px;
    }
  }
</style>

<script>
  import { ConstellationCanvas } from '../scripts/constellation';

  const constellationCanvas = document.getElementById('hero-constellation-canvas') as HTMLCanvasElement;
  if (constellationCanvas) {
    new ConstellationCanvas(constellationCanvas);
  }
</script>
