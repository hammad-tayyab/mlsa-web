---
import episodes from '../content/episodes.json';
import Rail from './Rail.astro';
import WinCard from './WinCard.astro';
---

<section class="scene podcast" id="podcast" aria-label="Podcast">
  <div class="podcast__header grid">
    <div class="col-content">
      <h2>Logikal Podcast.</h2>
      <p class="podcast__subtitle">Late-night studio conversations on tech, startups, and campus life at GIKI.</p>
    </div>
  </div>

  <div class="podcast__rail-wrapper">
    <Rail label="Logikal Podcast Episodes">
      {episodes.map(ep => {
        const epNum = String(ep.ep).padStart(3, '0');
        const isLatest = ep.ep === 13;

        return (
          <WinCard
            title={`Logikal_EP${epNum}.exe`}
            featured={isLatest}
          >
            <div class="episode-card-body" data-ep={ep.ep}>
              <div class="episode-top">
                <span class="label ep-badge">EP.{epNum} {isLatest ? '★ Latest' : ''}</span>
                {ep.date && <time class="mono ep-date" datetime={ep.date}>{ep.date}</time>}
              </div>

              <h3 class="episode-title">
                <a href={`/podcast/${ep.slug}`}>{ep.title}</a>
              </h3>

              {ep.guest && (
                <p class="episode-guest label">
                  Guest: <span class="guest-name">{ep.guest}</span>
                </p>
              )}

              <p class="episode-summary">{ep.summary}</p>

              <!-- Inline Player Container -->
              <div class="inline-player-slot" id={`player-slot-${ep.ep}`}>
                <div class="retro-waveform" aria-hidden="true">
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                  <span class="wave-bar"></span>
                </div>
              </div>

              <div class="episode-actions">
                <button
                  type="button"
                  class="btn btn-primary btn-sm play-btn"
                  data-ep={ep.ep}
                  data-youtube={ep.youtubeId || ''}
                  data-title={ep.title}
                >
                  ▶ Play Inline
                </button>
                <a href={`/podcast/${ep.slug}`} class="btn btn-ghost btn-sm">
                  Details &rarr;
                </a>
              </div>
            </div>
          </WinCard>
        );
      })}
    </Rail>
  </div>
</section>

<style>
  .podcast {
    overflow: hidden;
  }

  .podcast__header {
    padding-inline: clamp(16px, 5vw, 64px);
    margin-bottom: var(--space-xl);
  }

  .podcast__subtitle {
    margin-top: var(--space-xs);
    color: var(--text-muted);
  }

  .podcast__rail-wrapper {
    width: 100%;
  }

  .episode-card-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
    justify-content: space-between;
  }

  .episode-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ep-badge {
    color: var(--ms-blue);
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    text-transform: none;
    letter-spacing: 0.02em;
  }

  .ep-date {
    font-size: 15px;
    color: var(--text-muted);
  }

  .episode-title {
    font-size: var(--text-lg);
    line-height: 1.25;
  }

  .episode-title a {
    color: var(--text-primary);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .episode-title a:hover {
    color: var(--ms-yellow);
  }

  .episode-guest {
    font-family: var(--font-body);
    font-size: 16px;
    font-weight: 500;
    text-transform: none;
    color: var(--text-muted);
  }

  .guest-name {
    color: var(--ms-green);
  }

  .episode-summary {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    line-height: 1.6;
    flex: 1;
  }

  /* Retro waveform display */
  .retro-waveform {
    display: flex;
    align-items: center;
    gap: 4px;
    height: 24px;
    padding: 4px 8px;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
  }

  .wave-bar {
    flex: 1;
    background: var(--ms-blue);
    border-radius: 1px;
    height: 20%;
    transition: height 0.2s ease;
  }

  .is-playing .wave-bar {
    animation: wavePulse 0.8s ease-in-out infinite alternate;
  }

  .is-playing .wave-bar:nth-child(2) { animation-delay: 0.1s; }
  .is-playing .wave-bar:nth-child(3) { animation-delay: 0.2s; }
  .is-playing .wave-bar:nth-child(4) { animation-delay: 0.3s; }
  .is-playing .wave-bar:nth-child(5) { animation-delay: 0.15s; }
  .is-playing .wave-bar:nth-child(6) { animation-delay: 0.25s; }
  .is-playing .wave-bar:nth-child(7) { animation-delay: 0.05s; }
  .is-playing .wave-bar:nth-child(8) { animation-delay: 0.35s; }

  @keyframes wavePulse {
    0% { height: 15%; background: var(--ms-blue); }
    100% { height: 90%; background: var(--ms-yellow); }
  }

  .inline-player-frame {
    width: 100%;
    aspect-ratio: 16/9;
    border: none;
    border-radius: 2px;
    margin-top: 6px;
  }

  .episode-actions {
    display: flex;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
    padding-top: var(--space-sm);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .btn-sm {
    padding: 6px 14px;
    font-family: var(--font-pixel);
    font-size: 16px;
    font-weight: 600;
  }
</style>

<script>
  // Inline player logic for Logikal podcast episodes
  document.querySelectorAll('.play-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const ep = btn.getAttribute('data-ep');
      const ytId = btn.getAttribute('data-youtube');
      const slot = document.getElementById(`player-slot-${ep}`);
      if (!slot) return;

      const card = btn.closest('.episode-card-body');

      if (ytId) {
        // Embed real YouTube player
        slot.innerHTML = `<iframe class="inline-player-frame" src="https://www.youtube-nocookie.com/embed/${ytId}?autoplay=1" allow="autoplay; encrypted-media" allowfullscreen></iframe>`;
        btn.textContent = '■ Playing...';
      } else {
        // Toggle retro animated waveform simulation
        const isPlaying = card?.classList.contains('is-playing');
        if (isPlaying) {
          card?.classList.remove('is-playing');
          btn.textContent = '▶ Play Inline';
        } else {
          document.querySelectorAll('.episode-card-body').forEach(c => c.classList.remove('is-playing'));
          document.querySelectorAll('.play-btn').forEach(b => b.textContent = '▶ Play Inline');
          card?.classList.add('is-playing');
          btn.textContent = '⏸ Pause';
        }
      }
    });
  });
</script>
