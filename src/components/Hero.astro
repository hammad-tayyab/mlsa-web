---
import SkylineSVG from './SkylineSVG.astro';
import ClockTower from './ClockTower.astro';
import TileGrid from './TileGrid.astro';
import Cable from './Cable.astro';
---

<section class="scene hero" id="home" aria-label="Hero">
  <!-- Layer 0: Constellation particle background (replaces tile grid) -->
  <canvas id="hero-constellation-canvas" class="hero__constellation" aria-hidden="true"></canvas>

  <!-- Layer 1: Abstract skyline -->
  <SkylineSVG />

  <!-- Layer 2: Clock tower (centered at bottom) -->
  <div class="hero__tower-stage">
    <ClockTower class="hero__tower" />
  </div>

  <!-- Layer 3: Cable (behind text, z-index managed) -->
  <Cable class="hero__cable" />

  <!-- Layer 4: Content — split left so it doesn't overlap the tower -->
  <div class="hero__content">
    <div class="hero__text-block">
      <div class="hero__pill label">
        <span class="hero__pill-dot" aria-hidden="true"></span>
        <span>The Clock Tower Never Sleeps</span>
      </div>

      <h1 class="hero__title">
        <span class="hero__title-line">Microsoft</span>
        <span class="hero__title-line">Club <span class="hero__title-accent">GIKI</span></span>
      </h1>

      <p class="hero__sub">Learn. Build. Lead.</p>

      <div class="hero__ctas">
        <a href="#join" class="btn btn-primary">Join us</a>
        <a href="#podcast" class="btn btn-ghost">Hear Logikal</a>
      </div>
    </div>
  </div>

  <!-- Ground fog -->
  <div class="hero__fog" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--night-0);
    padding-block: 0;
  }

  .hero__constellation {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero__tower-stage {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    z-index: var(--z-tower);
    pointer-events: auto;
    display: flex;
    justify-content: center;
    align-items: flex-end;
  }

  .hero__tower {
    max-height: 58vh;
  }

  .hero__cable {
    z-index: 8; /* behind content z-index 100 */
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--grid-max-width);
    margin-inline: auto;
    padding-inline: var(--grid-margin);
    pointer-events: none;
  }

  .hero__text-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 520px;
    pointer-events: auto;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(11, 18, 48, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    width: fit-content;
    font-size: var(--text-xs);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .hero__pill-dot {
    width: 6px;
    height: 6px;
    background: var(--ms-green);
    box-shadow: 0 0 6px var(--ms-green);
    animation: blink 2.5s infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .hero__title {
    line-height: 1;
    color: var(--text-primary);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    color: var(--ms-blue);
  }

  .hero__sub {
    font-family: var(--font-pixel);
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero__fog {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to top, var(--night-0) 0%, transparent 100%);
    z-index: 55;
    pointer-events: none;
  }

  @media (max-width: 1024px) {
    .hero__text-block {
      max-width: 100%;
      align-items: center;
      text-align: center;
      margin-top: -28vh;
    }

    .hero__tower {
      max-height: 42vh;
    }
  }

  @media (max-width: 768px) {
    .hero__ctas {
      flex-direction: column;
      width: 100%;
      max-width: 240px;
    }
  }
</style>

<script>
  import { TowerChime } from '../scripts/audio';
  import { ConstellationCanvas } from '../scripts/constellation';

  // Constellation particle background
  const constellationCanvas = document.getElementById('hero-constellation-canvas') as HTMLCanvasElement;
  if (constellationCanvas) {
    new ConstellationCanvas(constellationCanvas);
  }

  // Easter egg: click tower to chime and spin hands
  const chime = new TowerChime();
  const tower = document.getElementById('hero-clock-tower');

  if (tower) {
    let isSpinning = false;
    tower.addEventListener('click', () => {
      chime.play();
      if (!isSpinning) {
        isSpinning = true;
        const hourHand = document.getElementById('clock-hour-hand');
        const minHand = document.getElementById('clock-minute-hand');
        if (hourHand && minHand) {
          hourHand.style.transition = 'transform 2.2s cubic-bezier(0.2, 0.8, 0.2, 1)';
          minHand.style.transition = 'transform 2.2s cubic-bezier(0.2, 0.8, 0.2, 1)';
          hourHand.style.transform = 'rotate(930deg)';
          minHand.style.transform = 'rotate(2160deg)';
          setTimeout(() => {
            hourHand.style.transition = 'transform 0.8s ease';
            minHand.style.transition = 'transform 0.8s ease';
            hourHand.style.transform = 'rotate(210deg)';
            minHand.style.transform = 'rotate(0deg)';
            isSpinning = false;
          }, 2400);
        }
      }
    });
  }
</script>
