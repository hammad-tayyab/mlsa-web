---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  type?: string;
  jsonLd?: object | object[];
  backLabel?: string;
  backHref?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  type = 'article',
  jsonLd,
  backLabel = 'Back',
  backHref = '/',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Organization JSON-LD
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Microsoft Club GIKI",
  "alternateName": ["Microsoft Club-GIKI", "MLSA GIKI", "Microsoft Learn Student Ambassadors GIKI"],
  "url": "https://mlsaclubgiki.tech",
  "logo": "https://mlsaclubgiki.tech/assets/logo.png",
  "sameAs": [
    "https://www.instagram.com/microsoftclubgiki/",
    "https://www.linkedin.com/company/microsoft-club-giki/",
    "https://www.youtube.com/@LOGIKALGIKI",
    "https://linktr.ee/MS_clubgiki"
  ]
};

const allJsonLd = jsonLd ? [orgJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])] : [orgJsonLd];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#070B1A" />

  <link rel="preload" href={`${base}/fonts/PixelifySans-Variable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/InstrumentSans-Variable.woff2`} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={`${base}/fonts/JetBrainsMono-Variable.woff2`} as="font" type="font/woff2" crossorigin />

  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml">
  <link rel="icon" href={`${base}/favicon.ico`} sizes="48x48">
  <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`}>

  <SEO
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    type={type}
    jsonLd={allJsonLd}
  />
</head>
<body>
  <Nav />

  <main class="detail-page">
    <div class="detail-page__inner grid">
      <div class="detail-page__back col-content">
        <a href={backHref} class="detail-page__back-link">
          <span aria-hidden="true">&larr;</span> {backLabel}
        </a>
      </div>
      <div class="detail-page__content col-content">
        <slot />
      </div>
    </div>
  </main>

  <Footer />
</body>
</html>

<style>
  .detail-page {
    padding-top: calc(60px + var(--space-xl));
    padding-bottom: var(--space-section);
    min-height: 100vh;
  }

  .detail-page__back {
    margin-bottom: var(--space-lg);
  }

  .detail-page__back-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .detail-page__back-link:hover {
    color: var(--text-primary);
  }

  .detail-page__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }
</style>

