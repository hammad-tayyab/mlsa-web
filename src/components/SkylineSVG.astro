---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`skyline-parallax-container ${className}`} id="skyline-parallax" aria-hidden="true">
  <!-- Layer 1: Night Stars (back) -->
  <svg class="parallax-layer layer-stars" viewBox="0 0 1920 1080" preserveAspectRatio="xMidYMid slice">
    <g fill="#FFFFFF" opacity="0.8">
      <circle cx="120" cy="80" r="1.5" />
      <circle cx="340" cy="140" r="1" />
      <circle cx="560" cy="60" r="2" />
      <circle cx="780" cy="190" r="1" />
      <circle cx="920" cy="90" r="1.8" />
      <circle cx="1140" cy="160" r="1.2" />
      <circle cx="1360" cy="70" r="2.2" />
      <circle cx="1520" cy="130" r="1" />
      <circle cx="1740" cy="85" r="1.6" />
      <circle cx="1860" cy="150" r="1.4" />
      <!-- Star cluster -->
      <circle cx="450" cy="220" r="0.8" opacity="0.6" />
      <circle cx="480" cy="240" r="1.2" opacity="0.9" />
      <circle cx="510" cy="210" r="0.8" opacity="0.7" />
      <circle cx="1280" cy="230" r="1.5" opacity="0.8" />
      <circle cx="1620" cy="200" r="1.2" opacity="0.7" />
      <circle cx="210" cy="300" r="1" opacity="0.5" />
      <circle cx="850" cy="260" r="1.5" opacity="0.7" />
    </g>
  </svg>

  <!-- Layer 2: Distant Hills (Topi / Swabi Horizon) -->
  <svg class="parallax-layer layer-hills" viewBox="0 0 1920 600" preserveAspectRatio="none">
    <path
      d="M0,380 Q220,290 480,340 T960,320 T1440,360 T1920,330 L1920,600 L0,600 Z"
      fill="#0B132B"
      opacity="0.85"
    />
    <path
      d="M0,420 Q300,340 640,390 T1280,370 T1920,400 L1920,600 L0,600 Z"
      fill="#101B3B"
      opacity="0.95"
    />
  </svg>

  <!-- Layer 3: Far Academic & Hostel Panorama (skyline-panorama.png) -->
  <svg class="parallax-layer layer-far-buildings" viewBox="0 0 1920 600" preserveAspectRatio="xMidYEnd slice">
    <!-- Stepped campus structures -->
    <g class="far-campus-blocks">
      <!-- Distant Left Block -->
      <polygon points="120,430 380,390 380,560 120,560" fill="#243354" opacity="0.6" />
      <!-- Distant Center Blocks -->
      <polygon points="440,340 780,340 780,560 440,560" fill="#1C2B4B" opacity="0.7" />
      <polygon points="760,280 1220,280 1220,560 760,560" fill="#223356" opacity="0.75" />
      <!-- High Skybridge connection on the right -->
      <rect x="1220" y="360" width="220" height="70" fill="#192744" opacity="0.8" />
      <g stroke="#2C406C" stroke-width="3">
        <line x1="1240" y1="360" x2="1240" y2="430" />
        <line x1="1260" y1="360" x2="1260" y2="430" />
        <line x1="1280" y1="360" x2="1280" y2="430" />
        <line x1="1300" y1="360" x2="1300" y2="430" />
        <line x1="1320" y1="360" x2="1320" y2="430" />
        <line x1="1340" y1="360" x2="1340" y2="430" />
        <line x1="1360" y1="360" x2="1360" y2="430" />
        <line x1="1380" y1="360" x2="1380" y2="430" />
        <line x1="1400" y1="360" x2="1400" y2="430" />
        <line x1="1420" y1="360" x2="1420" y2="430" />
      </g>
    </g>

    <!-- Campus window grids on far block -->
    <g class="far-windows" fill="#0E162B">
      <!-- Windows on left block -->
      <rect x="160" y="440" width="12" height="10" />
      <rect x="185" y="440" width="12" height="10" />
      <rect x="210" y="440" width="12" height="10" fill="#00A4EF" opacity="0.8" />
      <rect x="235" y="440" width="12" height="10" />
      <rect x="160" y="465" width="12" height="10" />
      <rect x="185" y="465" width="12" height="10" />
      <rect x="210" y="465" width="12" height="10" />
      <rect x="235" y="465" width="12" height="10" fill="#7FBA00" opacity="0.8" />

      <!-- Center tall block windows with MS accent lights -->
      <rect x="800" y="310" width="12" height="10" />
      <rect x="830" y="310" width="12" height="10" fill="#FFB900" opacity="0.9" />
      <rect x="860" y="310" width="12" height="10" />
      <rect x="890" y="310" width="12" height="10" fill="#00A4EF" opacity="0.9" />
      <rect x="920" y="310" width="12" height="10" />
      <rect x="950" y="310" width="12" height="10" />
      <rect x="980" y="310" width="12" height="10" fill="#F25022" opacity="0.9" />
      
      <rect x="800" y="335" width="12" height="10" />
      <rect x="830" y="335" width="12" height="10" />
      <rect x="860" y="335" width="12" height="10" fill="#FFB900" opacity="0.9" />
      <rect x="890" y="335" width="12" height="10" />
      <rect x="920" y="335" width="12" height="10" fill="#7FBA00" opacity="0.9" />
      <rect x="950" y="335" width="12" height="10" />
    </g>
  </svg>

  <!-- Layer 4: Main Academic Block (exact trace of academic-block.png, placed to the left/mid-ground) -->
  <svg class="parallax-layer layer-mid-buildings" viewBox="0 0 1920 600" preserveAspectRatio="xMidYEnd slice">
    <g class="academic-block-vector" transform="translate(180, 240) scale(0.68)">
      <!-- Main roof overhanging ledge -->
      <polygon points="50,70 590,70 560,95 80,95" fill="#E2EBF5" />
      
      <!-- Upper Section with Vertical Louvers -->
      <rect x="70" y="95" width="500" height="180" fill="#FFFFFF" />
      <!-- Dark backdrop inside louvers -->
      <rect x="80" y="105" width="480" height="160" fill="#0C152B" />
      
      <!-- Vertical white bars -->
      <g fill="#EAF0F9">
        <rect x="95" y="105" width="8" height="160" />
        <rect x="115" y="105" width="8" height="160" />
        <rect x="135" y="105" width="8" height="160" />
        <rect x="155" y="105" width="8" height="160" />
        <rect x="175" y="105" width="8" height="160" />
        <rect x="195" y="105" width="8" height="160" />
        <rect x="215" y="105" width="8" height="160" />
        <rect x="235" y="105" width="8" height="160" />
        <rect x="255" y="105" width="8" height="160" />
        <rect x="275" y="105" width="8" height="160" />
        <rect x="295" y="105" width="8" height="160" />
        <rect x="315" y="105" width="8" height="160" />
        <rect x="335" y="105" width="8" height="160" />
        <rect x="355" y="105" width="8" height="160" />
        <rect x="375" y="105" width="8" height="160" />
        <rect x="395" y="105" width="8" height="160" />
        <rect x="415" y="105" width="8" height="160" />
        <rect x="435" y="105" width="8" height="160" />
        <rect x="455" y="105" width="8" height="160" />
        <rect x="475" y="105" width="8" height="160" />
        <rect x="495" y="105" width="8" height="160" />
        <rect x="515" y="105" width="8" height="160" />
        <rect x="535" y="105" width="8" height="160" />
      </g>

      <!-- Lit window tiles inside louvers (MS Colors) -->
      <rect x="125" y="200" width="8" height="24" fill="#F25022" />
      <rect x="165" y="180" width="8" height="26" fill="#F25022" />
      <rect x="205" y="170" width="8" height="24" fill="#7FBA00" />
      <rect x="225" y="150" width="8" height="28" fill="#FFB900" />
      <rect x="265" y="120" width="8" height="32" fill="#FFB900" />
      <rect x="305" y="185" width="8" height="24" fill="#F25022" />
      <rect x="365" y="185" width="8" height="24" fill="#FFB900" />
      <rect x="405" y="135" width="8" height="26" fill="#F25022" />
      <rect x="445" y="165" width="8" height="28" fill="#7FBA00" />
      <rect x="525" y="180" width="8" height="24" fill="#7FBA00" />

      <!-- Lower Level Body -->
      <polygon points="30,275 610,275 580,290 60,290" fill="#CBD8E8" />
      <rect x="50" y="290" width="540" height="120" fill="#F2F6FC" />

      <!-- Left window panel (Navy with red line at base) -->
      <rect x="80" y="315" width="120" height="50" fill="#111B35" />
      <rect x="80" y="362" width="120" height="4" fill="#F25022" />

      <!-- Center Main Entrance (Navy panels with yellow base strip) -->
      <rect x="260" y="300" width="120" height="110" fill="#0C152B" />
      <line x1="290" y1="300" x2="290" y2="410" stroke="#1D2A4B" stroke-width="2" />
      <line x1="320" y1="300" x2="320" y2="410" stroke="#1D2A4B" stroke-width="2" />
      <line x1="350" y1="300" x2="350" y2="410" stroke="#1D2A4B" stroke-width="2" />
      <rect x="260" y="405" width="120" height="5" fill="#FFB900" />

      <!-- Right window panel (Navy with cyan line at base) -->
      <rect x="440" y="315" width="120" height="50" fill="#111B35" />
      <rect x="440" y="362" width="120" height="4" fill="#00A4EF" />

      <!-- Monumental Steps in Front -->
      <polygon points="100,410 540,410 570,455 70,455" fill="#A8BDD6" />
      <g stroke="#8FA8C5" stroke-width="2">
        <line x1="90" y1="418" x2="550" y2="418" />
        <line x1="85" y1="426" x2="555" y2="426" />
        <line x1="80" y1="434" x2="560" y2="434" />
        <line x1="75" y1="442" x2="565" y2="442" />
      </g>
      <!-- Base plinth -->
      <polygon points="10,455 630,455 570,490 70,490" fill="#90A8C6" opacity="0.8" />
    </g>
  </svg>

  <!-- Layer 5: Foreground Trees & Triangular Conifers (skyline-panorama.png) -->
  <svg class="parallax-layer layer-foreground" viewBox="0 0 1920 600" preserveAspectRatio="none">
    <!-- Ground road / platform strip -->
    <rect x="0" y="555" width="1920" height="45" fill="#9FB2CD" opacity="0.6" />

    <!-- Conical Conifers / Sculpted Trees along the campus boundary -->
    <g class="campus-trees">
      <!-- Conifer 1 (green pole tree) -->
      <polygon points="35,420 50,490 20,490" fill="#7FBA00" />
      <rect x="33" y="490" width="4" height="65" fill="#131F3B" />

      <!-- Triangular golden conifer row (exact from skyline-panorama.png) -->
      <polygon points="90,480 135,555 45,555" fill="#FFB900" />
      <polygon points="90,480 135,555 90,555" fill="#E6A500" />

      <polygon points="220,480 265,555 175,555" fill="#FFB900" />
      <polygon points="220,480 265,555 220,555" fill="#E6A500" />

      <polygon points="340,460 395,555 285,555" fill="#FFB900" />
      <polygon points="340,460 395,555 340,555" fill="#E6A500" />

      <polygon points="500,480 545,555 455,555" fill="#FFB900" />
      <polygon points="500,480 545,555 500,555" fill="#E6A500" />

      <polygon points="650,470 700,555 600,555" fill="#FFB900" />
      <polygon points="650,470 700,555 650,555" fill="#E6A500" />

      <polygon points="820,485 860,555 780,555" fill="#FFB900" />
      <polygon points="820,485 860,555 820,555" fill="#E6A500" />

      <polygon points="960,465 1010,555 910,555" fill="#FFB900" />
      <polygon points="960,465 1010,555 960,555" fill="#E6A500" />

      <polygon points="1120,475 1165,555 1075,555" fill="#FFB900" />
      <polygon points="1120,475 1165,555 1120,555" fill="#E6A500" />

      <polygon points="1320,470 1370,555 1270,555" fill="#FFB900" />
      <polygon points="1320,470 1370,555 1320,555" fill="#E6A500" />

      <polygon points="1520,450 1580,555 1460,555" fill="#FFB900" />
      <polygon points="1520,450 1580,555 1520,555" fill="#E6A500" />

      <polygon points="1720,470 1770,555 1670,555" fill="#FFB900" />
      <polygon points="1720,470 1770,555 1720,555" fill="#E6A500" />
    </g>
  </svg>
</div>

<style>
  .skyline-parallax-container {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: var(--z-sky);
  }

  .parallax-layer {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 100%;
    will-change: transform;
    pointer-events: none;
  }

  .layer-stars {
    z-index: 1;
    height: 70%;
    top: 0;
  }

  .layer-hills {
    z-index: 2;
    height: 55%;
  }

  .layer-far-buildings {
    z-index: 3;
    height: 50%;
  }

  .layer-mid-buildings {
    z-index: 4;
    height: 55%;
  }

  .layer-foreground {
    z-index: 6;
    height: 40%;
  }
</style>
