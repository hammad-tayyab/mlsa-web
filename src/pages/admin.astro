---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Admin | Microsoft Club GIKI" description="Admin panel — coming soon.">
  <main style="display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem;">
    <div style="text-align: center;">
      <h1 style="font-family: var(--font-display); font-size: var(--text-3xl); color: var(--text-primary);">Admin</h1>
      <p style="color: var(--text-muted); margin-top: 1rem;">This panel is out of scope for the current build.</p>
      <a href="/" style="display: inline-block; margin-top: 2rem; font-family: var(--font-mono); font-size: var(--text-sm); color: var(--ms-blue);">← Back to site</a>
    </div>
  </main>
</BaseLayout>

