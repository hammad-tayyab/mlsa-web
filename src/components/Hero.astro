---
import SkylineSVG from './SkylineSVG.astro';
---

<section class="scene hero" id="home" aria-label="Hero">
  <!-- Layer 1: Abstract skyline at base -->
  <SkylineSVG />

  <!-- Supplied campus illustrations layered above the abstract skyline -->
  <img class="hero__skyline-art" src="/skyline.svg" alt="" aria-hidden="true" />
  <img class="hero__hall-art" src="/hall.svg" alt="" aria-hidden="true" />

  <!-- Layer 2: Content — in left 60% so it doesn't overlap the fixed tower on the right -->
  <div class="hero__content">
    <div class="hero__text-block">
      <h1 class="hero__title">
        <span class="hero__title-line">Microsoft</span>
        <span class="hero__title-line">Club <span class="hero__title-accent">GIKI</span></span>
      </h1>

      <p class="hero__sub">Learn. Build. Lead.</p>

      <div class="hero__ctas">
        <a href="#join" class="btn btn-primary">Join us</a>
        <a href="#podcast" class="btn btn-ghost">Hear Logikal</a>
      </div>
    </div>
  </div>

  <!-- Ground fog -->
  <div class="hero__fog" aria-hidden="true"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: var(--night-0);
    padding-block: 0;
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    width: 100%;
    max-width: var(--grid-max-width);
    margin-inline: auto;
    padding-inline: var(--grid-margin);
    pointer-events: none;
  }

  .hero__skyline-art,
  .hero__hall-art {
    position: absolute;
    bottom: 0;
    height: auto;
    pointer-events: none;
    user-select: none;
  }

  .hero__skyline-art {
    left: 0;
    width: 70%;
    opacity: 0.85;
    z-index: 20;
  }

  .hero__hall-art {
    left: 50%;
    width: 34%;
    opacity: 0.9;
    transform: translateX(-8%);
    z-index: 21;
  }

  .hero__text-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 540px;
    pointer-events: auto;
  }

  .hero__title {
    line-height: 1;
    color: var(--text-primary);
    text-shadow: 0 4px 30px rgba(0, 0, 0, 0.9);
  }

  .hero__title-line {
    display: block;
  }

  .hero__title-accent {
    color: var(--ms-blue);
  }

  .hero__sub {
    font-family: var(--font-body);
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    letter-spacing: 0.04em;
    text-transform: none;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .hero__fog {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 200px;
    background: linear-gradient(to top, var(--night-0) 0%, transparent 100%);
    z-index: 55;
    pointer-events: none;
  }

  @media (max-width: 900px) {
    .hero__text-block {
      max-width: 100%;
    }
  }

  @media (min-width: 1024px) {
    .hero {
      height: 100vh;
    }
  }

  @media (max-width: 768px) {
    .hero__skyline-art {
      width: 140%;
      max-width: none;
    }

    .hero__hall-art {
      display: none;
    }

    .hero__ctas {
      flex-direction: column;
      width: 100%;
      max-width: 240px;
    }
  }
</style>
