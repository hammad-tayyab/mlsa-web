---
import members from '../content/members.json';
import Rail from './Rail.astro';
import WinCard from './WinCard.astro';
---

<section class="scene team" id="team" aria-label="Team">
  <div class="team__header grid">
    <div class="col-content">
      <span class="label">3:00 AM</span>
      <h2>The EC.</h2>
      <p class="team__subtitle">Hostel corridors, stayed up so you don't have to. Executive Committee 2026–2027.</p>
    </div>
  </div>

  <!-- Executive Committee Rail -->
  <div class="team__rail-wrapper">
    <Rail label="Executive Committee Members">
      {members.ec.map(member => {
        const exeName = member.name.toLowerCase().replace(/\s+/g, '_') + '.exe';
        return (
          <WinCard title={exeName}>
            <div class="member-card">
              <!-- 4:5 Portrait Frame -->
              <div class="portrait-frame pixel-art" role="img" aria-label={`Portrait of ${member.name}`}>
                {member.photo ? (
                  <img src={member.photo} alt={member.name} class="portrait-img" loading="lazy" />
                ) : (
                  <div class="portrait-placeholder">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2" />
                      <circle cx="12" cy="10" r="3" />
                      <path d="M7 21v-2a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v2" />
                    </svg>
                    <span class="label placeholder-label">4:5 PORTRAIT</span>
                  </div>
                )}
                <div class="portrait-scanlines" aria-hidden="true"></div>
              </div>

              <!-- Nameplate -->
              <div class="nameplate">
                <h3 class="member-name">{member.name}</h3>
                <span class="member-role label">{member.role}</span>
              </div>

              {member.linkedin && (
                <div class="member-footer">
                  <a href={member.linkedin} class="btn btn-ghost btn-sm" target="_blank" rel="noopener noreferrer">
                    LinkedIn &rarr;
                  </a>
                </div>
              )}
            </div>
          </WinCard>
        );
      })}
    </Rail>
  </div>

  <!-- Alumni Section Rail (Dimmer cards) -->
  {members.alumni && members.alumni.length > 0 && (
    <div class="alumni-section">
      <div class="alumni__header grid">
        <div class="col-content">
          <span class="label">Legacy</span>
          <h3 class="alumni-title">Alumni & Former Leads</h3>
        </div>
      </div>

      <div class="team__rail-wrapper">
        <Rail label="Alumni and Former Leads">
          {members.alumni.map(alum => {
            const exeName = alum.name.toLowerCase().replace(/\s+/g, '_') + '.exe';
            return (
              <WinCard title={exeName} dimmed={true}>
                <div class="member-card">
                  <div class="portrait-frame pixel-art" role="img" aria-label={`Portrait of ${alum.name}`}>
                    <div class="portrait-placeholder">
                      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                        <circle cx="12" cy="10" r="3" />
                        <path d="M7 21v-2a4 4 0 0 1 4-4h2a4 4 0 0 1 4 4v2" />
                      </svg>
                      <span class="label placeholder-label">ALUMNI</span>
                    </div>
                    <div class="portrait-scanlines" aria-hidden="true"></div>
                  </div>

                  <div class="nameplate">
                    <h4 class="member-name">{alum.name}</h4>
                    <span class="member-role label">{alum.role}</span>
                  </div>
                </div>
              </WinCard>
            );
          })}
        </Rail>
      </div>
    </div>
  )}
</section>

<style>
  .team {
    overflow: hidden;
  }

  .team__header {
    margin-bottom: var(--space-xl);
  }

  .team__subtitle {
    margin-top: var(--space-xs);
    color: var(--text-muted);
  }

  .team__rail-wrapper {
    width: 100%;
  }

  .member-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    height: 100%;
  }

  /* 4:5 Aspect Ratio portrait */
  .portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    background: #091024;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portrait-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: var(--text-muted);
  }

  .placeholder-label {
    font-size: 10px;
    letter-spacing: 0.1em;
  }

  .portrait-scanlines {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      rgba(0, 0, 0, 0.18),
      rgba(0, 0, 0, 0.18) 1px,
      transparent 1px,
      transparent 2px
    );
    pointer-events: none;
  }

  /* Retro Nameplate */
  .nameplate {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 8px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 2px;
  }

  .member-name {
    font-family: var(--font-pixel);
    font-size: var(--text-base);
    color: var(--text-primary);
  }

  .member-role {
    font-size: 11px;
    color: var(--ms-yellow);
    letter-spacing: 0.05em;
  }

  .member-footer {
    margin-top: auto;
  }

  .btn-sm {
    padding: 4px 12px;
    font-size: var(--text-xs);
  }

  /* Alumni Section */
  .alumni-section {
    margin-top: var(--space-3xl);
  }

  .alumni__header {
    margin-bottom: var(--space-lg);
  }

  .alumni-title {
    font-size: var(--text-xl);
    color: var(--text-secondary);
  }
</style>
