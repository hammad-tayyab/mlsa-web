---
---

<section class="scene hero" id="home" aria-label="Hero">
  <div class="hero__content grid">
    <div class="hero__text col-content">
      <h1 class="hero__title">Microsoft Club GIKI</h1>
      <p class="hero__sub">Learn. Build. Lead.</p>
      <div class="hero__ctas">
        <a href="#join" class="btn btn-primary">Join us</a>
        <a href="#podcast" class="btn btn-ghost">Hear Logikal</a>
      </div>
    </div>
  </div>

  <!-- Placeholder for skyline, tower, tile grid (Milestone 2) -->
  <div class="hero__skyline-placeholder asset-placeholder" aria-hidden="true">
    SKYLINE + TOWER + TILE GRID — Milestone 2
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .hero__content {
    position: relative;
    z-index: var(--z-content);
    text-align: center;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
  }

  .hero__title {
    color: var(--text-primary);
  }

  .hero__sub {
    font-family: var(--font-mono);
    font-size: var(--text-lg);
    color: var(--text-secondary);
    letter-spacing: 0.1em;
  }

  .hero__ctas {
    display: flex;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero__skyline-placeholder {
    position: absolute;
    inset: 0;
    z-index: var(--z-sky);
  }
</style>
