---
/**
 * Unified abstract skyline — no photo cutouts.
 * All buildings share the night palette, tinted with sky color.
 * Ground line + fog gradient at the base.
 */
---

<div class="skyline" id="skyline-parallax" aria-hidden="true">
  <svg class="skyline__svg" viewBox="0 0 1920 900" preserveAspectRatio="xMidYEnd slice">
    <defs>
      <linearGradient id="sky-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="var(--night-0)" />
        <stop offset="100%" stop-color="var(--night-1)" />
      </linearGradient>
      <linearGradient id="bldg-tint" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#15203D" />
        <stop offset="100%" stop-color="#0C1428" />
      </linearGradient>
      <linearGradient id="bldg-light" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#1C2D52" />
        <stop offset="100%" stop-color="#121E38" />
      </linearGradient>
    </defs>

    <!-- Stars -->
    <g class="skyline__stars" fill="#FFF" opacity="0.7">
      <circle cx="120" cy="60" r="1.5" /><circle cx="340" cy="120" r="1" />
      <circle cx="560" cy="45" r="2" /><circle cx="780" cy="160" r="1" />
      <circle cx="920" cy="70" r="1.8" /><circle cx="1140" cy="130" r="1.2" />
      <circle cx="1360" cy="55" r="2.2" /><circle cx="1520" cy="110" r="1" />
      <circle cx="1740" cy="65" r="1.6" /><circle cx="1860" cy="130" r="1.4" />
      <circle cx="450" cy="190" r="0.8" opacity="0.6" />
      <circle cx="1280" cy="200" r="1.5" opacity="0.5" />
      <circle cx="210" cy="260" r="1" opacity="0.4" />
      <circle cx="850" cy="220" r="1.2" opacity="0.6" />
      <circle cx="1620" cy="170" r="1" opacity="0.5" />
    </g>

    <!-- Distant Hills -->
    <path d="M0,620 Q220,540 480,580 T960,560 T1440,590 T1920,570 L1920,900 L0,900 Z" fill="#0A1125" opacity="0.7" />
    <path d="M0,660 Q300,590 640,630 T1280,610 T1920,650 L1920,900 L0,900 Z" fill="#0E1830" opacity="0.85" />

    <!-- Far Buildings (leftmost cluster) -->
    <g fill="url(#bldg-tint)">
      <rect x="40" y="580" width="140" height="320" rx="1" />
      <rect x="60" y="540" width="80" height="360" rx="1" />
    </g>
    <!-- Windows on far left -->
    <g fill="#0A1222">
      <rect x="70" y="560" width="10" height="8" /><rect x="90" y="560" width="10" height="8" />
      <rect x="70" y="580" width="10" height="8" /><rect x="90" y="580" width="10" height="8" fill="#00A4EF" opacity="0.7" />
      <rect x="70" y="600" width="10" height="8" /><rect x="90" y="600" width="10" height="8" />
    </g>

    <!-- Mid-left buildings -->
    <g fill="url(#bldg-light)">
      <rect x="220" y="520" width="180" height="380" rx="1" />
      <rect x="260" y="490" width="100" height="410" rx="1" />
    </g>
    <g fill="#0A1222">
      <rect x="280" y="510" width="10" height="8" /><rect x="300" y="510" width="10" height="8" fill="#FFB900" opacity="0.8" />
      <rect x="320" y="510" width="10" height="8" /><rect x="280" y="530" width="10" height="8" />
      <rect x="300" y="530" width="10" height="8" /><rect x="320" y="530" width="10" height="8" fill="#7FBA00" opacity="0.8" />
    </g>

    <!-- Academic Block (center-left, abstracted with louvers) -->
    <g class="skyline__academic">
      <!-- Main body -->
      <rect x="450" y="480" width="300" height="420" fill="url(#bldg-light)" rx="1" />
      <!-- Upper louver section -->
      <rect x="460" y="490" width="280" height="140" fill="#0B1428" />
      <!-- Vertical bars -->
      <g fill="#1C2D52" opacity="0.7">
        <rect x="470" y="490" width="6" height="140" /><rect x="488" y="490" width="6" height="140" />
        <rect x="506" y="490" width="6" height="140" /><rect x="524" y="490" width="6" height="140" />
        <rect x="542" y="490" width="6" height="140" /><rect x="560" y="490" width="6" height="140" />
        <rect x="578" y="490" width="6" height="140" /><rect x="596" y="490" width="6" height="140" />
        <rect x="614" y="490" width="6" height="140" /><rect x="632" y="490" width="6" height="140" />
        <rect x="650" y="490" width="6" height="140" /><rect x="668" y="490" width="6" height="140" />
        <rect x="686" y="490" width="6" height="140" /><rect x="704" y="490" width="6" height="140" />
        <rect x="722" y="490" width="6" height="140" />
      </g>
      <!-- Lit tiles within louvers -->
      <rect x="512" y="560" width="6" height="20" fill="#F25022" opacity="0.9" />
      <rect x="560" y="530" width="6" height="22" fill="#7FBA00" opacity="0.9" />
      <rect x="614" y="545" width="6" height="18" fill="#FFB900" opacity="0.9" />
      <rect x="668" y="520" width="6" height="24" fill="#00A4EF" opacity="0.9" />
      <!-- Entrance -->
      <rect x="560" y="660" width="80" height="100" fill="#070E1F" rx="1" />
      <rect x="560" y="756" width="80" height="4" fill="#FFB900" opacity="0.8" />
      <!-- Lower panels -->
      <rect x="475" y="660" width="70" height="40" fill="#0B1428" />
      <rect x="655" y="660" width="70" height="40" fill="#0B1428" />
    </g>

    <!-- === TOWER GAP (center 820-1100, reserved for ClockTower component) === -->

    <!-- Right cluster (hostels / incubation center) -->
    <g fill="url(#bldg-tint)">
      <rect x="1140" y="530" width="200" height="370" rx="1" />
      <rect x="1180" y="500" width="120" height="400" rx="1" />
    </g>
    <g fill="#0A1222">
      <rect x="1200" y="520" width="10" height="8" fill="#F25022" opacity="0.8" />
      <rect x="1220" y="520" width="10" height="8" /><rect x="1240" y="520" width="10" height="8" />
      <rect x="1200" y="540" width="10" height="8" /><rect x="1220" y="540" width="10" height="8" fill="#FFB900" opacity="0.7" />
      <rect x="1240" y="540" width="10" height="8" />
    </g>

    <!-- Striped building (far right, like library) -->
    <rect x="1400" y="560" width="160" height="340" fill="url(#bldg-light)" rx="1" />
    <g fill="#0A1222" opacity="0.9">
      <rect x="1410" y="580" width="140" height="5" /><rect x="1410" y="600" width="140" height="5" />
      <rect x="1410" y="620" width="140" height="5" /><rect x="1410" y="640" width="140" height="5" />
      <rect x="1410" y="660" width="140" height="5" /><rect x="1410" y="680" width="140" height="5" />
    </g>
    <rect x="1440" y="600" width="8" height="5" fill="#7FBA00" opacity="0.8" />
    <rect x="1500" y="620" width="8" height="5" fill="#00A4EF" opacity="0.8" />

    <!-- Furthest right small block -->
    <g fill="url(#bldg-tint)">
      <rect x="1620" y="600" width="120" height="300" rx="1" />
    </g>

    <!-- Edge fade buildings -->
    <rect x="1780" y="640" width="140" height="260" fill="#0C1428" opacity="0.6" rx="1" />

    <!-- Ground line -->
    <line x1="0" y1="898" x2="1920" y2="898" stroke="#2A3B5E" stroke-width="2" opacity="0.8" />
  </svg>
</div>

<style>
  .skyline {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    pointer-events: none;
    z-index: var(--z-sky);
  }

  .skyline__svg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 80%;
    min-height: 400px;
  }

  @media (max-width: 768px) {
    .skyline__svg {
      height: 60%;
    }
  }
</style>
