---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class={`custom-cursor-container ${className}`} id="custom-cursor" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-ring">
    <div class="cursor-torch-beam"></div>
  </div>
</div>

<style>
  .custom-cursor-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: var(--z-cursor);
    opacity: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .cursor-dot {
    position: absolute;
    top: -3px;
    left: -3px;
    width: 6px;
    height: 6px;
    background-color: var(--white);
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: difference;
    will-change: transform;
  }

  .cursor-ring {
    position: absolute;
    top: -18px;
    left: -18px;
    width: 36px;
    height: 36px;
    border: 1.5px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    pointer-events: none;
    mix-blend-mode: difference;
    will-change: transform;
    transition: width 0.25s var(--ease-spring),
                height 0.25s var(--ease-spring),
                border-color 0.25s var(--ease-out),
                top 0.25s var(--ease-spring),
                left 0.25s var(--ease-spring);
  }

  /* Active state over buttons and links */
  :global(.cursor--active) .cursor-ring {
    width: 54px;
    height: 54px;
    top: -27px;
    left: -27px;
    border-color: var(--ms-blue);
    background: rgba(0, 164, 239, 0.12);
  }

  :global(.cursor--torch) .cursor-ring {
    width: 48px;
    height: 48px;
    top: -24px;
    left: -24px;
    border-color: rgba(255, 255, 255, 0.85);
  }

  /* Glow halo around torch */
  .cursor-torch-beam {
    display: none;
  }

  :global(.cursor--torch) .cursor-torch-beam {
    display: block;
    position: absolute;
    inset: -60px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 210, 122, 0.15) 0%, transparent 70%);
    pointer-events: none;
  }

  /* Hide on touch devices */
  @media (pointer: coarse) {
    .custom-cursor-container {
      display: none !important;
    }
  }
</style>

<script>
  import { CustomCursor } from '../scripts/cursor';

  const cursorEl = document.getElementById('custom-cursor');
  if (cursorEl) {
    new CustomCursor(cursorEl);
  }
</script>
